---
const { title = "Button", href = "/" } = Astro.props;
---

<!-- Use an anchor so the href works in the browser -->
<a class="btn-home" href={href}>{title}</a>
<style>
  .btn-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    background-color: black;
    border: 2px solid black;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    padding: 8px 16px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.409);
    margin: 10px;
  }

  .btn-home:hover {
    background-color: white;
    color: black;
    cursor: pointer;
  }
</style>