---
import Button from "@components/Button.astro";

const assignments: { url: string; pageTitle: string }[] = Object.values(
  import.meta.glob("/src/pages/assignments/*", {
    eager: true,
  })
);

---

<ul>
  {
    assignments.map((assignment) => {
      return (
        <li>
          <a href={assignment.url}>{assignment.pageTitle}</a>
        </li>
      );
    })
  } 
  <a class="final" href="https://victorianchild.netlify.app">Project 1 - Victorian Child </a>
 <a class="final" href="https://christianschaiblelinks.netlify.app">Project 2 - Linktree </a>
</ul>

<style>
  ul {
    list-style: none;
    padding: 0
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
  }
  li {
    margin: 0;
  }
  a.final {
    background-color: white;
    color: black;
    padding: .5rem;
    border-radius: .5rem;
  }
  
</style>
