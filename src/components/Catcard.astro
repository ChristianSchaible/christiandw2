---
const {data} = Astro.props;
import Catimage from './Catimage.astro';
---
<div class="cat-card">
<Catimage imageID={data.reference_image_id}/>
<h1> {data.name} </h1>
<p> {data.description}</p>
<a href={data.wikipedia_url}>View {data.name} on Wikipedia</a>
</div>

<style>
    div.cat-card {
        background-color: black;
        color: white;
        padding: 10px;
        margin: 10px;
        border-radius: 1rem;
        display: flex;
        flex-direction: column;
        
    }
   a {
        background-color: white;
        color:black;
        margin-top: .5rem;
        padding:.5rem;
        width: fit-content;
        border-radius: 20px;
   

    }
        
</style>